# Copy to `.env` and fill in. `.env` MUST stay gitignored.
# Only variable NAMES live here - never real secrets.

# --- DeepSeek (official API) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model ids are configured here, never hardcoded in business logic.
DEEPSEEK_MODEL=

# --- GLM / Zhipu (official API) ---
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=

# --- Gemini (official API or Vertex) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Codex (official Codex login; no key is read or copied by the broker) ---
# Optional: override the Codex home directory (defaults to ~/.codex).
# CODEX_HOME=
# Model id for the Codex worker; "auto" lets Codex choose.
CODEX_MODEL=auto

# --- Local Claude Code harness (integrations/claude-code) ---
# The runner reads the backend endpoint/token from the environment, or from the script given as
# options.envScript. It writes them into a 0600 temporary settings file and never passes a secret
# on the command line. Any Anthropic-compatible endpoint works; DeepSeek is the documented default.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# --- Broker runtime ---
# Path to the YAML config file (defaults to ./config/providers.yaml)
BROKER_CONFIG=
# Shared secret for `mcp-http` (the endpoint refuses to start without it).
# Generate one with: openssl rand -hex 24
BROKER_HTTP_TOKEN=
# SQLite database file (defaults to ./data/broker.sqlite)
BROKER_DB_PATH=
# Set to 1 to store raw prompts in the trace store (default: off)
BROKER_TRACE_STORE_PROMPTS=
# Log level: debug | info | warn | error
BROKER_LOG_LEVEL=info
